.PHONY: all clean test test_programs
CC := gcc  # compiler used for Ksnap
CFLAGS := -g -Wall -Iinclude # flags (-g for debug info)
SRCS := $(wildcard src/*.c)
OBJS := $(SRCS:src/%.c=build/%.o)
# generated by -MMD: one .d per object, listing the headers it included
DEPS := $(OBJS:.o=.d)

# kept out of CFLAGS so that overriding CFLAGS from the command line, as the CI
# workflow does to add -Werror, cannot silently switch dependency tracking off
DEPFLAGS := -MMD -MP

TARGET := build/Ksnap

all: $(TARGET)


$(TARGET) : $(OBJS)
	$(CC) $(OBJS) -o $(TARGET)

build/%.o : src/%.c
	@mkdir -p build
	$(CC) $(CFLAGS) $(DEPFLAGS) -c $< -o $@

# the counter binaries are committed on purpose, the restore test depends on
# their exact layout, so only the helpers that are not a dump target are built
# here
test_programs: test_programs/threads test_programs/fpu_rounding \
	test_programs/fpu_spin test_programs/counter_dynamic_pie

test_programs/threads: test_programs/threads.c
	$(CC) -pthread -O0 -g $< -o $@

# static and non-PIE like counter_static_noPie, the layout the restore handles
test_programs/fpu_rounding: test_programs/fpu_rounding.c
	$(CC) -static -no-pie -O0 -g $< -o $@ -lm

# the same counter as counter_static_noPie, but dynamically linked and PIE, so
# the binary, ld.so and libc all land at random addresses in the original
test_programs/counter_dynamic_pie: test_programs/counter_static_noPie.c
	$(CC) -fPIE -pie -O0 -g $< -o $@

# -O2 keeps the accumulator in a register, -mavx makes that register a ymm one
test_programs/fpu_spin: test_programs/fpu_spin.c
	$(CC) -static -no-pie -O2 -mavx -g $< -o $@

test: test_programs
	test/./test_restore_validation.sh
	test/./test_static_noPie.sh
	test/./test_dynamic_pie.sh
	test/./test_dump_kill.sh
	test/./test_check.sh
	test/./test_fpu.sh

clean:
	rm -rf build/*

# without this a change to a header, dump_format.h above all, would leave the
# objects untouched and produce a binary that reads a different format than it
# writes. Included last, and silently, because the files do not exist yet on a
# first build.
-include $(DEPS)
